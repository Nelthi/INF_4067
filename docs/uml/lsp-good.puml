@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam class {
  BackgroundColor #F4F9E8
  BorderColor #5B7F00
}
skinparam NoteBackgroundColor #FFF6D6
hide empty members
title LSP - GOOD : Square et Rectangle implémentent Shape
interface Shape {
  +getArea(): int
}
class Rectangle {
  -width: int
  -height: int
  +getArea(): int
}
class Square {
  -side: int
  +getArea(): int
}
Shape <|.. Rectangle
Shape <|.. Square
@enduml
