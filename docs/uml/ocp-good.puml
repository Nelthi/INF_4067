@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam class {
  BackgroundColor #F4F9E8
  BorderColor #5B7F00
}
skinparam NoteBackgroundColor #FFF6D6
hide empty members
title OCP - GOOD : ouvert à l'extension, fermé à la modification
interface Shape {
  +calculateArea(): double
}
class Rectangle
class Circle
class Triangle <<ajout sans modification>>
class AreaCalculator {
  +calculateArea(shape: Shape): double
}
Shape <|.. Rectangle
Shape <|.. Circle
Shape <|.. Triangle
AreaCalculator ..> Shape
@enduml
